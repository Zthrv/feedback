PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=feedback_system

JWT_SECRET=
JWT_EXPIRES_IN=1d

# Optional
# FRONTEND_URL=http://localhost:5173
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b

# BERT-based checks: "hybrid" (BERT first, LLM for hard cases) or "llm" (LLM only)
# CLASSIFIER=hybrid

# Sites allowed to call the API (comma separated). Unset = any origin, for development only.
# CORS_ORIGINS=http://localhost:5173

# toxic-bert reads every feedback and gives six scores (0 to 1). A specific score at or above
# its BLOCK value rejects the feedback; any score at or above ALLOW sends it to the LLM.
# TOXICITY_BLOCK_SEVERE=0.5
# TOXICITY_BLOCK_THREAT=0.5
# TOXICITY_BLOCK_IDENTITY=0.5
# TOXICITY_BLOCK_INSULT=0.85
# TOXICITY_BLOCK_OBSCENE=0.85
# TOXICITY_ALLOW=0.4

# Abuse vectors (built by: node ml/train-abuse.js). A clause is rejected when it is this close
# to the examples of one type of abuse (score) and that much closer than to the clean examples
# (margin). Between REVIEW and BLOCK the LLM decides.
# ABUSE_BLOCK=0.58
# ABUSE_BLOCK_MARGIN=0.22
# ABUSE_REVIEW=0.4
# ABUSE_REVIEW_MARGIN=0.06
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# TOXICITY_MODEL=Xenova/toxic-bert
